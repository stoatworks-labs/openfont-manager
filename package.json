{
  "name": "openfont-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browse, search, preview and bulk-download open-source fonts from Google Fonts and Fontsource; feed it a CSV or XML list; and, as a desktop app, install fonts automatically at login from a watched folder or a network share.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "catalogue": "node scripts/build-catalogue.mjs && node scripts/build-fontsource-catalogue.mjs",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "fflate": "^0.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
